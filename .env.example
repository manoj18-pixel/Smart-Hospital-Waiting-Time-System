# Flask
SECRET_KEY=change-me-to-a-random-32-byte-secret
FLASK_CONFIG=development
FLASK_APP=run.py

# Database: sqlite (default) or mysql+pymysql://user:pass@host/dbname
# DATABASE_URL=mysql+pymysql://root:password@localhost/mediqueue
# Hosted PostgreSQL (Neon, Supabase, Railway) also works:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Mail: MailHog / console in development
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=MediQueue <no-reply@mediqueue.local>
MAIL_SUPPRESS_SEND=true

# Hospital rules
CANCELLATION_CUTOFF_HOURS=2
MAX_CANCELLATIONS_PER_30_DAYS=3
BOOKING_OPEN_DAYS=30

# Rate limiting (memory:// for development)
RATELIMIT_STORAGE_URI=memory://
